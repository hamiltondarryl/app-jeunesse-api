# Base PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jeunesse_app"

# Application
PORT=4000
APP_STATUS=DEV
FRONTEND_URL=http://localhost:4200

# JWT — générer une chaîne longue et aléatoire
JWT_SECRET="change-me-with-a-long-random-secret"

# Compte administrateur créé par le seeder
DEFAULT_ADMIN_EMAIL=admin@jeunesse.ga
DEFAULT_ADMIN_PASSWORD=Admin@Jeunesse2026
DEFAULT_USER_PASSWORD=Jeunesse@2026

# Mail (Mailtrap en local)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="Plateforme Jeunesse <from@example.com>"
