# Base PostgreSQL. En Docker, l’hôte est host.docker.internal (pas localhost).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jeunesse_app"

# Application
PORT=4000
# DEV en local (Swagger, CORS localhost, cookie non Secure). PROD sur le serveur.
APP_STATUS=DEV

# JWT — générer une chaîne longue et aléatoire :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-with-a-long-random-secret"

# Cookie de session. Laisser vide quand le site et l’API partagent le même domaine.
COOKIE_DOMAIN=

# Compte administrateur créé par le seeder (à changer à la première connexion)
DEFAULT_ADMIN_EMAIL=admin@jeunesse.ga
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_USER_PASSWORD=change-me

# Mail (Mailtrap en local)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="Plateforme Jeunesse <from@example.com>"
